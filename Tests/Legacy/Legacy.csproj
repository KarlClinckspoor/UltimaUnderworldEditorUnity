<Project Sdk="Microsoft.NET.Sdk">
  <!-- The editor's scripts as they were before the formats moved out of Unity ($(LegacyCommit),
       branch uw2-support), built against the same Unity stand-ins. The parity tests run this
       code and the moved code on the same game files. The sources are kept in legacy-src.zip
       (git archive of that commit's Assets/Scripts), so a shallow clone builds too. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Editor.Legacy</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LegacySrc>$(MSBuildProjectDirectory)/obj/legacy-src</LegacySrc>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../UnityStubs/UnityStubs.csproj" />
  </ItemGroup>

  <Target Name="ExtractLegacySources" BeforeTargets="CollectPackageReferences;BeforeBuild;CoreCompile" Condition="!Exists('$(LegacySrc)/$(LegacyCommit).done')">
    <RemoveDir Directories="$(LegacySrc)" />
    <MakeDir Directories="$(LegacySrc)" />
    <Unzip SourceFiles="$(MSBuildProjectDirectory)/legacy-src.zip" DestinationFolder="$(LegacySrc)" />
    <Touch Files="$(LegacySrc)/$(LegacyCommit).done" AlwaysCreate="true" />
  </Target>

  <Target Name="AddLegacySources" BeforeTargets="CoreCompile" DependsOnTargets="ExtractLegacySources">
    <ItemGroup>
      <Compile Include="$(LegacySrc)/Assets/Scripts/**/*.cs" />
    </ItemGroup>
  </Target>
</Project>
